# Standalone Catalog Seeder & Importer Image for Amazon EKS / CI
# Packages data/, config/, scripts/, and catalog-service code.
# Built from repository root: docker build -f Dockerfile.seed -t eks-store-seed .

FROM python:3.11-slim as builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# Production runtime stage
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app:/app/catalog-service"

# Install runtime PostgreSQL client library
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 appgroup \
    && useradd -u 10001 -g appgroup -s /bin/sh -m appuser

COPY --from=builder /install /usr/local

# Copy application assets, datasets, mappings, and scripts
COPY --chown=appuser:appgroup catalog-service/catalog_app /app/catalog-service/catalog_app
COPY --chown=appuser:appgroup config /app/config
COPY --chown=appuser:appgroup data /app/data
COPY --chown=appuser:appgroup scripts/import_catalog.py /app/scripts/import_catalog.py
COPY --chown=appuser:appgroup scripts/bootstrap_databases.py /app/scripts/bootstrap_databases.py

RUN mkdir -p /app/certs && curl --fail --silent --show-error --location \
    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    -o /app/certs/rds-ca.pem
ENV PGSSLROOTCERT=/app/certs/rds-ca.pem

USER appuser

ENTRYPOINT ["python", "scripts/import_catalog.py"]
