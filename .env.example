# ==============================================================================
# Environment Configuration Template (Safe Defaults for Local Development)
# Copy to .env for local overrides
# ==============================================================================

# Application Environments
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Connection Strings (Local Docker Compose)
# Note: In production on AWS, replace these hostnames with the private Amazon RDS endpoint
CATALOG_DATABASE_URL=postgresql+psycopg://catalog_user:catalog_pass@localhost:5432/catalog
ORDER_DATABASE_URL=postgresql+psycopg://order_user:order_pass@localhost:5432/orders

# Service Endpoints
CATALOG_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
CATALOG_SERVICE_URL=http://localhost:8001
CATALOG_TIMEOUT_SECONDS=5.0

# Image Resolution Mode: 'local' (serves from /assets) or 's3' (generates presigned URLs)
IMAGE_MODE=local
LOCAL_IMAGE_BASE_URL=/assets

# AWS S3 Settings (Used only when IMAGE_MODE=s3)
# Uses AWS default credential chain (IRSA on EKS, EC2 metadata, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
AWS_REGION=us-east-1
S3_BUCKET_NAME=eks-beverage-store-catalog
S3_PRESIGNED_EXPIRATION_SECONDS=3600

